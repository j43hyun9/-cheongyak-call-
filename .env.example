# ── LLM 엔진 선택 ──────────────────────────────────────────
# "openai" | "perso" | "local"
LLM_ENGINE=openai

# ── OpenAI ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Ollama (local 엔진, 파인튜닝 완료 후 사용) ─────────────
# LLM_ENGINE=local 으로 전환하면 아래 설정이 적용됨
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=colbi-qwen   # Ollama에 등록된 실제 모델명으로 교체

# ── PERSO API (전재형이 계약 후 채움) ──────────────────────
PERSO_API_KEY=
PERSO_MODEL=

# ── STT 엔진 ("openai"=Whisper API, OPENAI_API_KEY 재사용 / "local"=faster-whisper, CPU) ──
STT_ENGINE=openai
STT_MODEL=whisper-1
STT_LOCAL_MODEL=base   # STT_ENGINE=local일 때 사용할 faster-whisper 모델 크기

# ── 비용 추정 기준 (USD / 1K tokens) ───────────────────────
# gpt-4o-mini 기본값. 엔진 바꾸면 여기도 수정
COST_PER_1K_INPUT=0.00015
COST_PER_1K_OUTPUT=0.00060

# ── 캐시 TTL (초) ───────────────────────────────────────────
CACHE_TTL_SECONDS=3600
