# ── LLM 엔진 선택 ──────────────────────────────────────────
# "openai" | "perso" | "local"
LLM_ENGINE=openai

# ── OpenAI ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── PERSO API (전재형이 계약 후 채움) ──────────────────────
PERSO_API_KEY=
PERSO_MODEL=

# ── 비용 추정 기준 (USD / 1K tokens) ───────────────────────
# gpt-4o-mini 기본값. 엔진 바꾸면 여기도 수정
COST_PER_1K_INPUT=0.00015
COST_PER_1K_OUTPUT=0.00060

# ── 캐시 TTL (초) ───────────────────────────────────────────
CACHE_TTL_SECONDS=3600
